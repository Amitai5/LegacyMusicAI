# Real artist profiles are private local runtime state. Keep only the
# documentation and configuration template that describe the workflow.
/artists/**
!/artists/README.md
!/artists/_template/
!/artists/_template/**

# Downloaded foundation models, caches, and trained artifacts are local.
# models/README.md documents the expected directory structure.
/models/**
!/models/README.md

