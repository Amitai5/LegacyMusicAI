# The orchestration application resolves relative paths from the repository root.
LEGACY_MUSIC_CONFIG=config/app.yaml
LEGACY_MUSIC_LOG_LEVEL=INFO

# Keep model caches local and outside Git history.
HF_HOME=models/cache/huggingface
TORCH_HOME=models/cache/torch

# Engine-specific secrets belong only in .env, never in this template.
ACESTEP_API_KEY=
SOULX_PYTHON=
