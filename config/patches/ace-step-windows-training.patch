+def _json_safe_training_status(value: Any) -> Any:
+    """Replace non-finite training telemetry with JSON-compatible null values."""
+    if isinstance(value, float) and not math.isfinite(value):
+        return None
+    if isinstance(value, dict):
+        return {key: _json_safe_training_status(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe_training_status(item) for item in value]
+    return value
+
