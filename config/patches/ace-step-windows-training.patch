new file mode 100644
index 0000000..c2f8d09
--- /dev/null
+++ b/acestep/training/trainer_regression_test.py
@@ -0,0 +1,25 @@
+"""Regression contracts for the legacy LoRA training loop."""
+
+from __future__ import annotations
+
+import inspect
+import unittest
+
+from acestep.training.trainer import LoRATrainer
+
+
+class LoRATrainerRegressionTests(unittest.TestCase):
+    """Protect failure handling that is expensive to exercise with the full model."""
+
+    def test_nonfinite_remainder_does_not_average_a_reset_accumulator(self):
+        """A skipped remainder must continue before dividing by its reset counter."""
+
+        source = inspect.getsource(LoRATrainer._train_with_fabric)
+        reset_then_continue = "accumulation_step = 0\n                    continue"
+
+        self.assertIn("skipping optimizer remainder step", source)
+        self.assertIn(reset_then_continue, source)
+
+
+if __name__ == "__main__":
+    unittest.main()
